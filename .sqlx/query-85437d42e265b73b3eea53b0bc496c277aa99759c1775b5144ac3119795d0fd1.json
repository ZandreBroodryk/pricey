{
  "db_name": "PostgreSQL",
  "query": "\n        select i.id, i.name, i.currency, i.target_price_cents, i.notes, i.active,\n               count(s.id) as \"source_count!\"\n        from wishlist_items i\n        left join item_sources s on s.item_id = i.id\n        where i.user_id = $1\n        group by i.id\n        order by i.active desc, lower(i.name)\n        ",
