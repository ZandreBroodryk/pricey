# Copy to .env for local development (`docker compose up -d db` provides this database).
DATABASE_URL=postgres://pricey:pricey@localhost:5432/pricey

# Shared secret the /api/fetch-prices endpoint requires as `Authorization: Bearer <secret>`.
# If unset, that endpoint refuses to run at all.
CRON_SECRET=local-dev-secret

# "production" makes session cookies Secure. Leave unset/development for plain-HTTP localhost.
APP_ENV=development

RUST_LOG=info,pricey=debug

# Email verification (Resend). With RESEND_API_KEY unset, pricey logs the verification
# link at WARN instead of sending it -- which is what makes local signup work offline.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=pricey <noreply@your-verified-domain.com>

# Where verification links point. Must be the address a browser can actually reach.
APP_BASE_URL=http://127.0.0.1:3000
