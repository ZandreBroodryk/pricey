# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Local environment. Committed template lives in .env.example
.env

# NOTE: Cargo.lock is deliberately NOT ignored -- pricey ships as a deployed binary,
# so the lock file must be committed for reproducible container builds.
#
# NOTE: .sqlx/ is deliberately NOT ignored -- it is the offline query cache that lets
# the Docker build verify SQL at compile time without a reachable database.
