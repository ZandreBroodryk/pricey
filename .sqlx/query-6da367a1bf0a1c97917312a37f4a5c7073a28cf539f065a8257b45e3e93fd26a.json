  "db_name": "PostgreSQL",
  "query": "\n        select s.id as \"source_id!\", s.label as \"label!\",\n               p.price_cents, p.ok as \"ok!\", p.error, p.fetched_at as \"fetched_at!\",\n               p.manual as \"manual!\"\n        from price_snapshots p\n        join item_sources s on s.id = p.source_id\n        where s.item_id = $1\n        order by p.fetched_at desc\n        ",
